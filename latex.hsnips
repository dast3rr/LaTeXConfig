#fast math mode
snippet mk "Math" wA
$${1}$$0
endsnippet

#fast fraction
snippet // "Fraction" iA
\frac{$1}{$2}$0
endsnippet

#fast script
snippet ^ "superscript" iA
^{$1}$0
endsnippet

#fast subscript
snippet _ "subscript" iA
_{$1}$0
endsnippet

#fast sum
snippet sum "sum" iA
\sum_{${1:n=0}}^{${2:\infty}} $0
endsnippet

#fast infinity
snippet infty "infinity" iA
\infty
endsnippet